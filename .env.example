# =====================================================================
# 医养接力站 · 环境变量样例
# 复制成 .env 后按需填写；.env 已在 .gitignore 中，不会入库。
# =====================================================================

# ---- 数据库（本机便携版默认 3307，见 scripts/db-start.ps1）----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=carerelay
DB_USER=root
DB_PASSWORD=root

# ---- 后端端口（8080 常被占用，默认 8081）----
SERVER_PORT=8081

# ---- 登录令牌 ----
CR_JWT_SECRET=dev-only-secret-please-override-0123456789
CR_JWT_TTL_HOURS=72

# ---- 对话模型（OpenAI 兼容，填 DeepSeek 官方 key 即可跑通全部 AI 能力）----
CR_AI_BASE_URL=https://api.deepseek.com/v1
CR_AI_API_KEY=
CR_AI_MODEL=deepseek-chat
CR_AI_TIMEOUT_SECONDS=30

# ---- 向量模型（可留空：留空时 RAG 走本地 ngram + 余弦兜底，不需要额外 key）----
CR_AI_EMBEDDING_BASE_URL=
CR_AI_EMBEDDING_API_KEY=
CR_AI_EMBEDDING_MODEL=

# ---- 视觉模型（用于出院小结拍照/截图抽取；留空则该入口自动隐藏）----
CR_AI_IMAGE_BASE_URL=
CR_AI_IMAGE_API_KEY=
CR_AI_IMAGE_MODEL=

# ---- 语音转写（用于适老语音打卡；留空则只保留文字打卡）----
CR_AI_ASR_BASE_URL=
CR_AI_ASR_API_KEY=
CR_AI_ASR_MODEL=
